{
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/studio",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/apps/commander-table",
      "destination": "/apps/manatable",
      "permanent": true
    },
    {
      "source": "/get/commander-table",
      "destination": "/get/manatable",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/nox(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://ynwabowujlalbztriqwj.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}